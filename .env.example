CHAT_API_KEY=your-server-only-chat-key
CHAT_MODEL=your-tool-capable-chat-model
# Separate vision model for private monthly photo comparisons.
VISION_API_BASE_URL=https://api.example.com/v1
VISION_API_KEY=your-server-only-vision-key
VISION_MODEL=your-vision-capable-model
